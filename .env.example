# ==============================================================
# SURAKSH PLATFORM — ENVIRONMENT CONFIGURATION (OPTIONAL APIS)
# ==============================================================
# All features in SURAKSH work out-of-the-box in simulated Demo Mode
# without requiring any paid API keys. Configure below for production.

# Base URL for production backend (Supabase / Express / FastAPI)
VITE_API_BASE_URL=https://api.suraksh.gov.in/v1

# Optional Mapbox Tile Token (Default uses OpenStreetMap / CARTO Positron without token)
VITE_MAPBOX_ACCESS_TOKEN=

# Optional Geocoding API Key (Default uses OpenStreetMap Nominatim reverse lookup)
VITE_GEOCODING_API_KEY=

# Optional LLM API Key for real-time AI Copilot reasoning (e.g. Gemini / OpenAI)
# Keep in secure backend proxy in production. Never expose client-side keys.
VITE_GEMINI_API_KEY=
